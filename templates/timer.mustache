{{!
    @template mod_classroomtoolbox/timer

    The timer tool. The timer cards are built by the mod_classroomtoolbox/timer AMD module.

    Context variables required for this template:
    * uniqid - unique string used for element ids

    Example context (json):
    {
        "uniqid": "abc123"
    }
}}
<div class="mod_classroomtoolbox-timer" data-region="timer">
    <div class="d-flex flex-wrap align-items-center gap-3 mb-3">
        <button type="button" class="btn btn-secondary" data-action="timer-add">{{#str}} timer_add, mod_classroomtoolbox {{/str}}</button>
        <button type="button" class="btn btn-primary" data-action="timer-startall">{{#str}} timer_startall, mod_classroomtoolbox {{/str}}</button>
        <div class="form-check form-switch mb-0">
            <input class="form-check-input" type="checkbox" role="switch" id="timer-sound-{{uniqid}}" data-action="timer-sound" checked>
            <label class="form-check-label" for="timer-sound-{{uniqid}}">{{#str}} sound, mod_classroomtoolbox {{/str}}</label>
        </div>
    </div>
    <template data-region="timer-sound-source">
        <label class="form-label small mb-0" data-role="label">{{#str}} timer_alarmsound, mod_classroomtoolbox {{/str}}</label>
        <select class="form-select form-select-sm" data-role="select">
            <option value="siren">{{#str}} sound_siren, mod_classroomtoolbox {{/str}}</option>
            <option value="beeps">{{#str}} sound_beeps, mod_classroomtoolbox {{/str}}</option>
            <option value="clock">{{#str}} sound_clock, mod_classroomtoolbox {{/str}}</option>
            <option value="klaxon">{{#str}} sound_klaxon, mod_classroomtoolbox {{/str}}</option>
            <option value="futuristic">{{#str}} sound_futuristic, mod_classroomtoolbox {{/str}}</option>
            <option value="duck">{{#str}} sound_duck, mod_classroomtoolbox {{/str}}</option>
        </select>
        <button type="button" class="btn btn-outline-secondary btn-sm" data-role="try">{{#str}} timer_trysound, mod_classroomtoolbox {{/str}}</button>
    </template>
    <div class="row g-3" data-region="timer-list"></div>
    <div class="visually-hidden" role="status" aria-live="polite" data-region="timer-live"></div>
</div>
