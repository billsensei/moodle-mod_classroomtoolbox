{{!
    @template mod_classroomtoolbox/scoreboard

    The scoreboard tool. The list is built by the mod_classroomtoolbox/scoreboard AMD module. Teachers (canmanage)
    get the controls to add entries and change points; everyone else gets a read-only board that refreshes itself.

    Context variables required for this template:
    * uniqid - unique string used for element ids
    * canmanage - whether the viewer may change the scoreboard
    * hasparticipants - whether to offer "Add participants" (teachers only)
    * hasgroups - whether to offer "Add groups" (teachers only)

    Example context (json):
    {
        "uniqid": "abc123",
        "canmanage": true,
        "hasparticipants": true,
        "hasgroups": true
    }
}}
<div class="mod_classroomtoolbox-scoreboard" data-region="scoreboard">
    {{#canmanage}}
    <div class="card mb-3">
        <div class="card-body">
            <form class="d-flex flex-wrap align-items-end gap-2 mb-2" data-region="score-add-form">
                <div>
                    <label for="score-add-{{uniqid}}" class="form-label mb-0">{{#str}} score_addlabel, mod_classroomtoolbox {{/str}}</label>
                    <input type="text" id="score-add-{{uniqid}}" class="form-control" maxlength="100" data-region="score-add-input">
                </div>
                <button type="submit" class="btn btn-primary">{{#str}} score_add, mod_classroomtoolbox {{/str}}</button>
                {{#hasgroups}}
                <button type="button" class="btn btn-secondary" data-action="score-add-groups">{{#str}} score_addgroups, mod_classroomtoolbox {{/str}}</button>
                {{/hasgroups}}
                {{#hasparticipants}}
                <button type="button" class="btn btn-secondary" data-action="score-add-participants">{{#str}} score_addparticipants, mod_classroomtoolbox {{/str}}</button>
                {{/hasparticipants}}
            </form>
            <div class="d-flex flex-wrap align-items-end gap-3">
                <div>
                    <label for="score-step-{{uniqid}}" class="form-label mb-0">{{#str}} score_step, mod_classroomtoolbox {{/str}}</label>
                    <input type="number" id="score-step-{{uniqid}}" class="form-control mod_classroomtoolbox-narrow-input" min="1" max="100" value="1" data-region="score-step">
                </div>
                <button type="button" class="btn btn-outline-danger" data-action="score-reset">{{#str}} score_reset, mod_classroomtoolbox {{/str}}</button>
            </div>
        </div>
    </div>
    {{/canmanage}}
    <p class="text-muted" data-region="score-empty"></p>
    <ol class="list-unstyled mod_classroomtoolbox-score-list" data-region="score-list" aria-label="{{#str}} tool_scoreboard, mod_classroomtoolbox {{/str}}"></ol>
    <div class="form-check form-switch mt-2">
        <input class="form-check-input" type="checkbox" role="switch" id="score-pause-{{uniqid}}" data-action="score-pause">
        <label class="form-check-label" for="score-pause-{{uniqid}}">{{#str}} score_pause, mod_classroomtoolbox {{/str}}</label>
    </div>
    {{^canmanage}}
    <p class="small text-muted">{{#str}} score_autorefresh, mod_classroomtoolbox {{/str}}</p>
    {{/canmanage}}
    <div class="visually-hidden" role="status" aria-live="polite" data-region="score-live"></div>
</div>
