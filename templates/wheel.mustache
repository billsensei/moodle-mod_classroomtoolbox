{{!
    @template mod_namewheel/wheel

    The spinning wheel page body. All behaviour is attached by the mod_namewheel/wheel AMD module.

    Context variables required for this template:
    * uniqid - unique string used for element ids
    * hasnames - whether the wheel starts with any names

    Example context (json):
    {
        "uniqid": "abc123",
        "hasnames": true
    }
}}
<div class="mod_namewheel row" data-region="namewheel">
    <div class="col-lg-8 mb-3">
        <div class="mod_namewheel-stage position-relative mx-auto">
            <div class="mod_namewheel-pointer" aria-hidden="true"></div>
            <canvas class="mod_namewheel-canvas" data-region="namewheel-canvas" tabindex="0" role="button"
                aria-label="{{#str}} clickhere, mod_namewheel {{/str}}" width="600" height="600"></canvas>
            <button type="button" class="mod_namewheel-hub btn btn-primary" data-action="spin">
                {{#str}} spin, mod_namewheel {{/str}}
            </button>
        </div>
        <p class="text-center text-muted mt-2 mb-0" data-region="namewheel-hint">{{#str}} clickhere, mod_namewheel {{/str}}</p>
        <div class="visually-hidden" role="status" aria-live="polite" data-region="namewheel-live"></div>
    </div>
    <div class="col-lg-4">
        <div class="card">
            <div class="card-body">
                <h3 class="h5 card-title">
                    <label for="namewheel-entries-{{uniqid}}">{{#str}} entries, mod_namewheel {{/str}}</label>
                </h3>
                <textarea id="namewheel-entries-{{uniqid}}" class="form-control mb-2" rows="12" data-region="namewheel-entries"></textarea>
                <p class="small text-muted mb-2" data-region="namewheel-count"></p>
                <div class="d-flex flex-wrap gap-2">
                    <button type="button" class="btn btn-secondary btn-sm" data-action="shuffle">{{#str}} shuffle, mod_namewheel {{/str}}</button>
                    <button type="button" class="btn btn-secondary btn-sm" data-action="sort">{{#str}} sort, mod_namewheel {{/str}}</button>
                    <button type="button" class="btn btn-secondary btn-sm" data-action="reset">{{#str}} resetwheel, mod_namewheel {{/str}}</button>
                </div>
            </div>
        </div>
    </div>

    <div class="mod_namewheel-result" data-region="namewheel-result" hidden>
        <div class="mod_namewheel-result-box card shadow" role="dialog" aria-modal="true"
            aria-labelledby="namewheel-winner-{{uniqid}}">
            <div class="card-body text-center">
                <p class="mb-1 text-muted">{{#str}} winner, mod_namewheel {{/str}}</p>
                <p class="mod_namewheel-winner display-4 mb-3" id="namewheel-winner-{{uniqid}}" data-region="namewheel-winner"></p>
                <div class="d-flex justify-content-center flex-wrap gap-2">
                    <button type="button" class="btn btn-danger" data-action="remove">{{#str}} removename, mod_namewheel {{/str}}</button>
                    <button type="button" class="btn btn-primary" data-action="keep">{{#str}} keepname, mod_namewheel {{/str}}</button>
                </div>
            </div>
        </div>
    </div>
</div>
