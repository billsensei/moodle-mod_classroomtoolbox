{{!
    @template mod_classroomtoolbox/wheel

    The spinning wheel page body. All behaviour is attached by the mod_classroomtoolbox/wheel AMD module.

    Context variables required for this template:
    * uniqid - unique string used for element ids
    * hasnames - whether the wheel starts with any names
    * hasgroups - whether the group chooser is shown

    Example context (json):
    {
        "uniqid": "abc123",
        "hasnames": true,
        "hasgroups": true
    }
}}
<div class="mod_classroomtoolbox row" data-region="wheel">
    <div class="col-lg-8 mb-3">
        <div class="mod_classroomtoolbox-wheel-stage position-relative mx-auto">
            <div class="mod_classroomtoolbox-wheel-pointer" aria-hidden="true"></div>
            <canvas class="mod_classroomtoolbox-wheel-canvas" data-region="wheel-canvas" tabindex="0" role="button"
                aria-label="{{#str}} clickhere, mod_classroomtoolbox {{/str}}" width="600" height="600"></canvas>
            <button type="button" class="mod_classroomtoolbox-wheel-hub btn btn-primary" data-action="spin">
                {{#str}} spin, mod_classroomtoolbox {{/str}}
            </button>
        </div>
        <p class="text-center text-muted mt-2 mb-0" data-region="wheel-hint">{{#str}} clickhere, mod_classroomtoolbox {{/str}}</p>
        <div class="visually-hidden" role="status" aria-live="polite" data-region="wheel-live"></div>
    </div>
    <div class="col-lg-4">
        {{#hasgroups}}
        <div class="card mb-3">
            <div class="card-body">
                <fieldset>
                    <legend class="h5">{{#str}} groups, mod_classroomtoolbox {{/str}}</legend>
                    <div class="d-flex flex-wrap gap-2 mb-2">
                        <button type="button" class="btn btn-secondary btn-sm" data-action="groups-all">{{#str}} selectall, mod_classroomtoolbox {{/str}}</button>
                        <button type="button" class="btn btn-secondary btn-sm" data-action="groups-none">{{#str}} selectnone, mod_classroomtoolbox {{/str}}</button>
                    </div>
                    <div data-region="wheel-groups"></div>
                </fieldset>
            </div>
        </div>
        {{/hasgroups}}
        <div class="card">
            <div class="card-body">
                <h3 class="h5 card-title">
                    <label for="wheel-entries-{{uniqid}}">{{#str}} entries, mod_classroomtoolbox {{/str}}</label>
                </h3>
                <textarea id="wheel-entries-{{uniqid}}" class="form-control mb-2" rows="12" data-region="wheel-entries"></textarea>
                <p class="small text-muted mb-2" data-region="wheel-count"></p>
                <div class="d-flex flex-wrap gap-2">
                    <button type="button" class="btn btn-secondary btn-sm" data-action="shuffle">{{#str}} shuffle, mod_classroomtoolbox {{/str}}</button>
                    <button type="button" class="btn btn-secondary btn-sm" data-action="sort">{{#str}} sort, mod_classroomtoolbox {{/str}}</button>
                    <button type="button" class="btn btn-secondary btn-sm" data-action="reset">{{#str}} resetwheel, mod_classroomtoolbox {{/str}}</button>
                </div>
            </div>
        </div>
    </div>

    <div class="mod_classroomtoolbox-wheel-result" data-region="wheel-result" hidden>
        <div class="mod_classroomtoolbox-wheel-result-box card shadow" role="dialog" aria-modal="true"
            aria-labelledby="wheel-winner-{{uniqid}}">
            <div class="card-body text-center">
                <p class="mb-1 text-muted">{{#str}} winner, mod_classroomtoolbox {{/str}}</p>
                <p class="mod_classroomtoolbox-wheel-winner display-4 mb-3" id="wheel-winner-{{uniqid}}" data-region="wheel-winner"></p>
                <div class="d-flex justify-content-center flex-wrap gap-2">
                    <button type="button" class="btn btn-danger" data-action="remove">{{#str}} removename, mod_classroomtoolbox {{/str}}</button>
                    <button type="button" class="btn btn-primary" data-action="keep">{{#str}} keepname, mod_classroomtoolbox {{/str}}</button>
                </div>
            </div>
        </div>
    </div>
</div>
