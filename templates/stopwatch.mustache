{{!
    @template mod_classroomtoolbox/stopwatch

    The stopwatch tool. Behaviour is attached by the mod_classroomtoolbox/stopwatch AMD module.

    Context variables required for this template:
    * uniqid - unique string used for element ids

    Example context (json):
    {
        "uniqid": "abc123"
    }
}}
<div class="mod_classroomtoolbox-stopwatch text-center" data-region="stopwatch">
    <div class="mod_classroomtoolbox-display" data-region="sw-display" role="timer" aria-live="off">00:00.00</div>
    <div class="d-flex justify-content-center flex-wrap gap-2 my-3">
        <button type="button" class="btn btn-primary btn-lg" data-action="sw-toggle">{{#str}} sw_start, mod_classroomtoolbox {{/str}}</button>
        <button type="button" class="btn btn-secondary btn-lg" data-action="sw-lap" disabled>{{#str}} sw_lap, mod_classroomtoolbox {{/str}}</button>
        <button type="button" class="btn btn-secondary btn-lg" data-action="sw-reset">{{#str}} sw_reset, mod_classroomtoolbox {{/str}}</button>
    </div>
    <div class="mx-auto text-start mod_classroomtoolbox-laps" data-region="sw-laps-wrap" hidden>
        <h3 class="h5">{{#str}} sw_laps, mod_classroomtoolbox {{/str}}</h3>
        <ol class="list-group list-group-numbered" data-region="sw-laps"></ol>
    </div>
    <div class="visually-hidden" role="status" aria-live="polite" data-region="sw-live"></div>
</div>
